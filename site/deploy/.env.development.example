# Copy to /home/jon/docker/ts.rookaro.com-dev/.env with mode 0600.
# Replace secret placeholders with unique development-only values. Never copy production values.
COMPOSE_PROJECT_NAME=tsrookarocom-dev
POSTGRES_DB=tool_shed_dashboard_dev
POSTGRES_USER=tool_shed_dashboard_dev
POSTGRES_PASSWORD=replace-with-a-unique-development-password
TOOL_SHED_DASHBOARD_SECRET_KEY=replace-with-at-least-50-development-only-random-characters
TOOL_SHED_DASHBOARD_ALLOWED_HOSTS=192.168.7.5,127.0.0.1,localhost
TOOL_SHED_DASHBOARD_CSRF_ORIGINS=http://192.168.7.5:8443,http://127.0.0.1:8443,http://localhost:8443
TOOL_SHED_DASHBOARD_AUTH_MODE=local-mfa
TOOL_SHED_DASHBOARD_ENVIRONMENT=development
TOOL_SHED_DASHBOARD_ALLOW_INSECURE_HTTP=1
TOOL_SHED_DASHBOARD_SESSION_COOKIE_NAME=tool_shed_dev_sessionid
TOOL_SHED_DASHBOARD_CSRF_COOKIE_NAME=tool_shed_dev_csrftoken
TOOL_SHED_DASHBOARD_HEALTH_HOST=192.168.7.5
TOOL_SHED_DASHBOARD_HEALTH_PROTO=http
TOOL_SHED_DASHBOARD_IMAGE_TAG=development-candidate
TOOL_SHED_DOCS_CONTAINER_NAME=ts-rookaro-com-dev
TOOL_SHED_SITE_BIND_ADDRESS=192.168.7.5
TOOL_SHED_SITE_PORT=8443
TOOL_SHED_POSTGRES_CPUS=0.5
TOOL_SHED_POSTGRES_MEMORY=512m
TOOL_SHED_DASHBOARD_CPUS=1.0
TOOL_SHED_DASHBOARD_MEMORY=768m
TOOL_SHED_DOCS_CPUS=0.25
TOOL_SHED_DOCS_MEMORY=128m
