    {"type": "decision", "namespace": "DEC", "authority": "sqlite"},
    {"type": "inventory", "namespace": "INV", "authority": "sqlite"},
    {"type": "runbook", "namespace": "RUN", "authority": "sqlite"},
    {"type": "workpackage", "namespace": "WP", "authority": "sqlite"},
    {"type": "incident", "namespace": "INC", "authority": "sqlite"},
    {"type": "q-and-a", "namespace": "QNA", "authority": "sqlite"},
