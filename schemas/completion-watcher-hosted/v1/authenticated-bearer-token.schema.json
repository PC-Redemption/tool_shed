{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts.rookaro.com/schemas/completion-watcher-hosted/v1/authenticated-bearer-token.schema.json",
  "title": "Tool Shed hosted API token claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "capabilities",
    "issued_at",
    "expires_at",
    "issuer"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "watch:read",
          "event:ingest",
          "event:replay"
        ]
      },
      "uniqueItems": true
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "maxLength": 120},
    "subject": {"type": "string", "maxLength": 120},
    "revoked": {"type": "boolean"}
  }
}
