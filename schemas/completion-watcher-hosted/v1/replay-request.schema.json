{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts.rookaro.com/schemas/completion-watcher-hosted/v1/replay-request.schema.json",
  "title": "Tool Shed hosted replay request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "watch_id",
    "workspace_id",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": {
      "enum": ["manual_replay", "operator_retry", "backfill", "outage_recovery", "observability_test"]
    },
    "reason_detail": {"type": "string", "maxLength": 512}
  }
}
