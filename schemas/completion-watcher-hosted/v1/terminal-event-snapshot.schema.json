{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts.rookaro.com/schemas/completion-watcher-hosted/v1/terminal-event-snapshot.schema.json",
  "title": "Tool Shed hosted terminal-event snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "idempotency_key",
    "workspace",
    "watch_id",
    "target",
    "terminal_class",
    "reason_code",
    "occurred_at",
    "state",
    "created_at",
    "last_seen_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^watch-terminal-v1:[0-9a-f]{64}$"},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "alias": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "generation": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "terminal_class": {
      "enum": [
        "SATISFIED",
        "TERMINAL_UNSATISFIED",
        "CHECK_ERROR_EXHAUSTED",
        "WATCH_CANCELLED",
        "RETIRED_WITHOUT_CONCLUSION"
      ]
    },
    "reason_code": {
      "enum": [
        "TARGET_SUCCEEDED",
        "CONDITION_MET",
        "TARGET_FAILED",
        "TARGET_CANCELLED",
        "TARGET_PREEMPTED",
        "TARGET_SUPERSEDED",
        "TARGET_MISSING_AFTER_GRACE",
        "CONSECUTIVE_CHECK_ERRORS_EXHAUSTED",
        "OPERATOR_CANCELLED_WATCH",
        "ADMINISTRATIVE_RETIREMENT"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "state": {
      "enum": [
        "INGESTING",
        "QUEUED",
        "ACKED",
        "PROCESSING",
        "RETRY_PENDING",
        "DELIVERED",
        "FAILED_PERMANENT"
      ]
    },
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 20},
    "retry_after": {"type": "string", "format": "date-time"},
    "redacted_summary": {"type": "string", "maxLength": 512},
    "tenant_boundary": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_class": {"const": "SATISFIED"}}},
      "then": {"properties": {"reason_code": {"enum": ["TARGET_SUCCEEDED", "CONDITION_MET"]}}}
    },
    {
      "if": {"properties": {"terminal_class": {"const": "TERMINAL_UNSATISFIED"}}},
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "TARGET_FAILED",
              "TARGET_CANCELLED",
              "TARGET_PREEMPTED",
              "TARGET_SUPERSEDED",
              "TARGET_MISSING_AFTER_GRACE"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"terminal_class": {"const": "CHECK_ERROR_EXHAUSTED"}}},
      "then": {"properties": {"reason_code": {"const": "CONSECUTIVE_CHECK_ERRORS_EXHAUSTED"}}}
    },
    {
      "if": {"properties": {"terminal_class": {"const": "WATCH_CANCELLED"}}},
      "then": {"properties": {"reason_code": {"const": "OPERATOR_CANCELLED_WATCH"}}}
    },
    {
      "if": {"properties": {"terminal_class": {"const": "RETIRED_WITHOUT_CONCLUSION"}}},
      "then": {"properties": {"reason_code": {"const": "ADMINISTRATIVE_RETIREMENT"}}}
    }
  ]
}
