{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-shed.local/schemas/outcome-reconciliation/v1/manifest.schema.json",
  "title": "Tool Shed outcome reconciliation manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "mode",
    "project_id",
    "expected_revision",
    "expected_domain_digest",
    "cycle",
    "artifacts",
    "requirements",
    "changes",
    "evidence",
    "verifications",
    "verdict",
    "reconciliation",
    "ambiguities",
    "manifest_token"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "tool-shed-outcome-reconciliation-manifest"},
    "mode": {"enum": ["current", "historical-overlay", "direct"]},
    "project_id": {"type": "string", "format": "uuid"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "expected_domain_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_at": {"type": "string"},
    "authorization_ref": {"type": "string"},
    "cycle": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "changes": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "verifications": {"type": "array", "items": {"type": "object"}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "verdict": {"type": "object"},
    "reconciliation": {"type": "object"},
    "ambiguities": {"type": "array"},
    "manifest_token": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  },
  "additionalProperties": false
}
