{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts.rookaro.com/schemas/document-store/v1/conversion-manifest.schema.json",
  "title": "Tool Shed Document Conversion Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "prepared_at", "baseline", "entries", "manifest_token"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "tool-shed-document-conversion-manifest"},
    "project_id": {"type": "string", "format": "uuid"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "manifest_token": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_bindings", "relationships", "history_rows"],
      "properties": {
        "artifact_bindings": {"type": "array", "items": {"type": "object"}},
        "relationships": {"type": "array", "items": {"type": "object"}},
        "history_rows": {"type": "array", "items": {"type": "object"}}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "git_state", "classification", "document_type", "namespace", "assigned_number", "artifact_id", "warning"],
        "properties": {
          "path": {"type": "string", "pattern": "^work/"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_state": {"enum": ["tracked", "untracked", "ignored", "unknown"]},
          "classification": {"enum": ["generated", "file-owned", "projection", "unresolved"]},
          "document_type": {"type": ["string", "null"]},
          "namespace": {"type": ["string", "null"]},
          "assigned_number": {"type": ["integer", "null"], "minimum": 1},
          "artifact_id": {"type": ["string", "null"], "format": "uuid"},
          "warning": {"type": ["string", "null"]}
        }
      }
    }
  }
}
