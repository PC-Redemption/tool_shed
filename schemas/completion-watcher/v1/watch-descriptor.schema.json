{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts.rookaro.com/schemas/completion-watcher/v1/watch-descriptor.schema.json",
  "title": "Tool Shed completion watcher descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "watch_id",
    "created_at",
    "display_name",
    "workspace",
    "target",
    "checker",
    "policy",
    "notification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "workspace": {"$ref": "#/$defs/workspace"},
    "target": {"$ref": "#/$defs/target_identity"},
    "checker": {"$ref": "#/$defs/checker"},
    "policy": {"$ref": "#/$defs/policy"},
    "notification": {"$ref": "#/$defs/notification"},
    "review_url": {"type": "string", "format": "uri", "maxLength": 2048}
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "alias": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"$ref": "#/$defs/safe_id"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "generation": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_seconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 55},
        "working_directory": {"type": "string", "minLength": 1, "maxLength": 4096},
        "credential_profile": {"$ref": "#/$defs/safe_id"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poll_interval_seconds",
        "missing_grace_checks",
        "max_consecutive_check_errors",
        "claim_lease_seconds",
        "idle_exit_scans"
      ],
      "properties": {
        "poll_interval_seconds": {"const": 60},
        "missing_grace_checks": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_consecutive_check_errors": {"type": "integer", "minimum": 1, "maximum": 20},
        "claim_lease_seconds": {"type": "integer", "minimum": 60, "maximum": 900},
        "idle_exit_scans": {"const": 2},
        "review_after": {"type": "string", "format": "date-time"},
        "administrative_retire_after": {"type": "string", "format": "date-time"}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"enum": ["none", "project", "hosted"]},
        "profile": {"$ref": "#/$defs/safe_id"}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"enum": ["project", "hosted"]}}},
          "then": {"required": ["profile"]}
        },
        {
          "if": {"properties": {"adapter": {"const": "none"}}},
          "then": {"not": {"required": ["profile"]}}
        }
      ]
    }
  }
}
