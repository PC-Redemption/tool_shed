      "requirement_ids": [
        "REQ-CLOSED-010",
        "REQ-CLOSED-011"
      ],
      "source_commit": "af8c4560f8a8087e7116854a0291e443b1d7d874",
      "summary": "Prove exact direct-SQL acceptance and deterministic recovery",
      "supersedes": []
    },
    {
      "authorization": "Owner-authorized end-to-end Universal Closed-Loop PRM and exact-candidate CI response on 2026-08-28",
      "decision_ids": [
        "DEC-CLOSED-005",
        "DEC-CLOSED-007"
      ],
      "evidence_to_rerun": [
        "EVID-CLOSED-G4-RECOVERY"
      ],
      "id": "CHG-CLOSED-004",
      "rationale": "The first exact-candidate matrix proved all behavioral shards except one transient Windows budget overrun; shard zero correctly refused release validation while G4 and its three implemented migration items remained open. Recording the completed migrations and terminal G4 verdict makes the staged release gate reflect the product state before the exact rerun.",
      "recorded_at": "2026-08-28T21:35:13Z",
      "requirement_ids": [
        "REQ-CLOSED-002",
        "REQ-CLOSED-005",
        "REQ-CLOSED-010"
      ],
      "source_commit": "150ef1670ab9c0df81f3029cac072e7434e9ed43",
      "summary": "Reconcile staged release validation with the completed G4 migration boundary",
      "supersedes": []
    }
  ],
  "decisions": [
    {
      "id": "DEC-CLOSED-001",
      "rationale": "Activity completion and outcome realization answer different questions and must remain independently reportable.",
      "status": "settled",
      "summary": "Keep lifecycle, outcome verdict, and reconciliation as independent dimensions"
    },
    {
      "id": "DEC-CLOSED-002",
      "rationale": "A central vocabulary and graph prevent entry-point-specific tools from drifting into incompatible meanings of completion.",
      "status": "settled",
      "summary": "Use one entry-point-neutral reconciliation engine"
    },
    {
      "id": "DEC-CLOSED-003",
      "rationale": "The released hybrid substrate already provides the minimum structured tables, recovery ledger, and checkpoint needed by the universal slice.",
      "status": "settled",
      "summary": "Use schema-version-1 hybrid state before proposing schema expansion"
    },
    {
      "id": "DEC-CLOSED-004",
      "rationale": "Owner-authored narrative benefits from Git review and flexible Markdown, while mutable relational closure state benefits from guarded SQLite transactions.",
      "status": "settled",
      "summary": "Preserve the current file and SQLite authority split without dual writes"
    },
    {
      "id": "DEC-CLOSED-005",
      "rationale": "Later knowledge must not make historical records appear more complete than they were at the time.",
      "status": "settled",
      "summary": "Backfill through dated overlays and preserve historical ambiguity"
    },
    {
      "id": "DEC-CLOSED-006",
      "rationale": "Minimum sufficient coordination requires direct work to remain light while still allowing durable product changes to close explicitly.",
      "status": "settled",
      "summary": "Allow compact direct-work closure capsules instead of mandatory artifacts"
    },
    {
      "id": "DEC-CLOSED-007",
      "rationale": "A feature cannot safely be the sole authority that declares its own correctness during implementation.",
      "status": "settled",
      "summary": "Keep an independent file and Git bootstrap closure through final release proof"
    },
    {
      "id": "DEC-CLOSED-008",
      "rationale": "The released-client canary consumes publication, so publication must be gated by G1 through G4 while G5 and the initiative remain open until the canary reconciles.",
      "status": "settled",
      "summary": "Stage publication before the final disconnected-client gate"
    }
  ],
