      ],
      "id": "CHG-HYBRID-004",
      "rationale": "M3 implementation turns the frozen no-data-loss sequence into an executable controller. Fixed first-import IDs, exact tracked/untracked/ignored inventory, an external byte-verified archive, two disposable semantic rehearsals, SQLite backup, direct-SQL and interruption recovery, worktree-lineage refusal, guarded storage-mode activation, checkpoint rebuild, legacy-writer refusal, and soak evidence prevent live cutover from relying on informal operator steps.",
      "recorded_at": "2026-08-28T17:34:17Z",
      "requirement_ids": [
        "REQ-HYBRID-003",
        "REQ-HYBRID-004",
        "REQ-HYBRID-007",
