  "decisions": [
    {
      "id": "DEC-HYBRID-001",
      "rationale": "Per-worktree state prevents database sharing from becoming an implicit branch or merge mechanism.",
      "status": "settled",
      "summary": "Use one ignored SQLite database per verified Git worktree at .tool-shed/state.sqlite3."
    },
    {
      "id": "DEC-HYBRID-002",
      "rationale": "This gives every field one authority and limits the first conversion to the minimum proving workload.",
      "status": "settled",
      "summary": "Keep imported source, product truth, general Markdown bodies, and excluded lifecycle domains file-authoritative in phase one."
    },
    {
      "id": "DEC-HYBRID-003",
      "rationale": "Stable normalized values remain portable across paths, platforms, worktrees, and rebuilds.",
      "status": "settled",
      "summary": "Use lowercase UUIDv4 public IDs, UTC whole-second timestamps, and lowercase SHA-256 digests."
    },
    {
      "id": "DEC-HYBRID-004",
      "rationale": "Explicit fields and authority prevent implementation convenience from silently expanding phase-one scope.",
      "status": "settled",
      "summary": "Freeze SQLite schema version 1 to the explicit metadata, graph, closed-loop, migration, export, and checkpoint fields in the contract."
    },
    {
      "id": "DEC-HYBRID-005",
      "rationale": "Supported scripts remain the normal interface while bypass writes are detectable and require exact reconciliation.",
      "status": "settled",
      "summary": "Use triggers and managed-operation accounting to classify direct SQL and fail closed on unjournaled or invalid state."
    },
    {
      "id": "DEC-HYBRID-006",
      "rationale": "Git receives a portable logical recovery surface without tracking the frequently changing SQLite binary.",
      "status": "settled",
      "summary": "Use one canonical tracked state-v1 JSON checkpoint with digest-bound deterministic ordering and shadow rebuild verification."
    },
    {
      "id": "DEC-HYBRID-007",
      "rationale": "This preserves durable review points without commit spam from ordinary managed access.",
      "status": "settled",
      "summary": "Checkpoint at semantic boundaries or after 100 revisions or 24 hours, not on every database access."
    },
    {
      "id": "DEC-HYBRID-008",
      "rationale": "Path order, timestamps, and live database reuse cannot safely decide competing intent or verdicts.",
      "status": "settled",
      "summary": "Merge checkpoints by stable IDs and explicit independent fields; semantic conflicts require reconciliation."
    },
    {
      "id": "DEC-HYBRID-009",
      "rationale": "Verified rollback material and non-destructive promotion are required for the no-data-loss promise.",
      "status": "settled",
      "summary": "Retain the newest three verified SQLite backups and require shadow migration plus semantic comparison before promotion."
    },
    {
      "id": "DEC-HYBRID-010",
      "rationale": "Protocol 3 does not inventory, back up, migrate, verify, or restore live database state.",
      "status": "settled",
      "summary": "Reserve updater protocol 4 for database-aware releases and require older updaters to refuse before mutation."
    },
    {
      "id": "DEC-HYBRID-011",
      "rationale": "An in-place down migration could lose database-authoritative changes after cutover.",
      "status": "settled",
      "summary": "Allow downgrade only through a verified reverse export; otherwise refuse and name the blocking state."
    },
    {
      "id": "DEC-HYBRID-012",
      "rationale": "The dual-role maintainer does not use the disconnected snapshot updater against itself.",
      "status": "settled",
      "summary": "Rehearse externally, convert the canonical maintainer first, publish second, synchronize the installed skill separately, and canary one client last."
    },
    {
      "id": "DEC-HYBRID-013",
      "rationale": "Plausible reconstruction would weaken the closed-loop audit by inventing original intent or delivery evidence.",
      "status": "settled",
      "summary": "Preserve missing HPT2 history as unknown and block satisfaction until it is obtained or explicitly dispositioned."
    },
    {
      "id": "DEC-HYBRID-014",
      "rationale": "Token savings are an evidence-based outcome, not an assumption caused by choosing SQLite.",
      "status": "settled",
      "summary": "Qualify small, exact maintainer, and large fixtures at 70 percent median context reduction and at most 5 percent explained fallback with full semantic parity."
    }
  ],
